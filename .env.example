# ---------------------------------------------------------------------------
# Contact form email (SMTP)
#
# Locally these are read from .env. On Vercel you must set them in
# Project Settings > Environment Variables instead — the .env file is
# gitignored and is NOT deployed. See DEPLOY.md.
# ---------------------------------------------------------------------------

# Gmail example (app password, not your account password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form submissions are delivered.
CONTACT_EMAIL=info@kaizenmfb.com

# Optional: the From/Reply envelope sender. Defaults to SMTP_USER. Set this
# only if you send through a provider that authorises a different From domain.
# CONTACT_FROM=no-reply@kaizenmfb.com

# Optional: throttle submissions from one IP. Defaults: 5 per 10 minutes.
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_MS=600000

# Optional: only needed when the API is hosted on a DIFFERENT hostname than
# the site. Same-origin deployments (Vercel, or the bundled Express server)
# need nothing here, and leaving it empty makes the server refuse
# cross-origin browser calls rather than allow them by accident.
# ALLOWED_ORIGINS=https://kaizenmfb.com,https://www.kaizenmfb.com
